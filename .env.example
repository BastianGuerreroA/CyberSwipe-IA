# Configuración del servidor Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Parámetros de inferencia y hardware
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=-1
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_GPU=0

# Configuración de rutas de salida
OUTPUT_DIR=output
HISTORY_DIR=output/history
LATEST_DIR=output/latest

# Configuración de logs (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
